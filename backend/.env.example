# Every setting the backend reads (see src/config.ts). All have local defaults; set what you need.

# --- Database --------------------------------------------------------------------------------
DATABASE_URL=postgres://booking:booking@localhost:5433/booking
# Only for `npm test` (a separate database, wiped by the test run)
TEST_DATABASE_URL=postgres://booking:booking@localhost:5433/booking_test

# --- Server ----------------------------------------------------------------------------------
PORT=4000
# In production JWT_SECRET is required (the app refuses to start without it)
NODE_ENV=development

# --- Log-in tokens ---------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Booking rules ---------------------------------------------------------------------------
# Bookings must start at least this many minutes ahead
MIN_NOTICE_MINUTES=120
# Most new accounts one IP address can create per hour
SIGNUPS_PER_HOUR=20

# --- Reminders -------------------------------------------------------------------------------
# How often the worker looks for due reminders (milliseconds)
REMINDER_POLL_MS=10000
# Also run the reminder worker inside the API process (single-process hosting such as Render)
RUN_REMINDER_WORKER=false

# --- Demo and hosting ------------------------------------------------------------------------
# Create the fictional demo accounts on start-up when the database is empty
SEED_DEMO_DATA=false
# Folder of the built frontend; when set, the API also serves the web app (single-service hosting)
STATIC_DIR=
